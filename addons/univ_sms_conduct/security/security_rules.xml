<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_conduct_score_portal_own" model="ir.rule">
        <field name="name">Portal: own conduct scores only</field>
        <field name="model_id" ref="model_univ_sms_conduct_score"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_conduct_score_line_portal_own" model="ir.rule">
        <field name="name">Portal: own conduct score lines only</field>
        <field name="model_id" ref="model_univ_sms_conduct_score_line"/>
        <field name="domain_force">[('conduct_score_id.student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
