<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_univ_sms_exam_result_tree" model="ir.ui.view">
        <field name="name">univ.sms.exam.result.tree</field>
        <field name="model">univ.sms.exam.result</field>
        <field name="arch" type="xml">
            <tree string="Kết quả thi" editable="bottom">
                <field name="exam_id"/>
                <field name="student_id"/>
                <field name="score"/>
                <field name="max_score"/>
                <field name="percentage" widget="percentage"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_sms_exam_result_search" model="ir.ui.view">
        <field name="name">univ.sms.exam.result.search</field>
        <field name="model">univ.sms.exam.result</field>
        <field name="arch" type="xml">
            <search string="Tìm kết quả thi">
                <field name="exam_id"/>
                <field name="student_id"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_exam" string="Kỳ thi" context="{'group_by': 'exam_id'}"/>
                    <filter name="group_by_student" string="Sinh viên" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_sms_exam_result" model="ir.actions.act_window">
        <field name="name">Kết quả thi</field>
        <field name="res_model">univ.sms.exam.result</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
