<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sinh viên portal chỉ đọc điểm và bảng điểm của chính mình (chặn truy cập chéo qua JSON-RPC) -->
    <record id="rule_exam_result_portal_own" model="ir.rule">
        <field name="name">Portal: own exam results only</field>
        <field name="model_id" ref="model_univ_sms_exam_result"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_transcript_portal_own" model="ir.rule">
        <field name="name">Portal: own transcripts only</field>
        <field name="model_id" ref="model_univ_sms_transcript"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_transcript_line_portal_own" model="ir.rule">
        <field name="name">Portal: own transcript lines only</field>
        <field name="model_id" ref="model_univ_sms_transcript_line"/>
        <field name="domain_force">[('transcript_id.student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <!-- Kỳ thi: sinh viên chỉ thấy kỳ thi của lớp mình đang học -->
    <record id="rule_exam_portal_own_class" model="ir.rule">
        <field name="name">Portal: exams of own classes only</field>
        <field name="model_id" ref="model_univ_sms_exam"/>
        <field name="domain_force">[('class_id.enrollment_ids.student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Nội bộ: giảng viên chỉ thao tác kỳ thi / điểm của lớp mình dạy.
         Rule theo nhóm được OR với nhau: Phòng Đào tạo/Admin thấy tất cả,
         cố vấn đọc điểm SV mình cố vấn, trưởng khoa và CTSV đọc tất cả. -->
    <record id="rule_exam_lecturer_own_class" model="ir.rule">
        <field name="name">Lecturer: exams of own classes</field>
        <field name="model_id" ref="model_univ_sms_exam"/>
        <field name="domain_force">[('class_id.lecturer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_lecturer'))]"/>
    </record>
    <record id="rule_exam_officer_all" model="ir.rule">
        <field name="name">Officer/Admin: all exams</field>
        <field name="model_id" ref="model_univ_sms_exam"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_academic_officer'))]"/>
    </record>
    <record id="rule_exam_staff_read_all" model="ir.rule">
        <field name="name">Advisor/Dean/Offices: read all exams</field>
        <field name="model_id" ref="model_univ_sms_exam"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_advisor')), (4, ref('univ_sms_base.group_univ_dean')), (4, ref('univ_sms_base.group_univ_student_affairs_office')), (4, ref('univ_sms_base.group_univ_finance_office'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_exam_result_lecturer_own_class" model="ir.rule">
        <field name="name">Lecturer: results of own classes</field>
        <field name="model_id" ref="model_univ_sms_exam_result"/>
        <field name="domain_force">[('class_id.lecturer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_lecturer'))]"/>
    </record>
    <record id="rule_exam_result_officer_all" model="ir.rule">
        <field name="name">Officer/Admin: all exam results</field>
        <field name="model_id" ref="model_univ_sms_exam_result"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_academic_officer'))]"/>
    </record>
    <record id="rule_exam_result_advisor_students" model="ir.rule">
        <field name="name">Advisor: read results of advised students</field>
        <field name="model_id" ref="model_univ_sms_exam_result"/>
        <field name="domain_force">['|', ('student_id.advisor_id', '=', user.partner_id.id), ('student_id.home_class_id.advisor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_advisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_exam_result_dean_read_all" model="ir.rule">
        <field name="name">Dean/Student affairs: read all exam results</field>
        <field name="model_id" ref="model_univ_sms_exam_result"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_dean')), (4, ref('univ_sms_base.group_univ_student_affairs_office'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_lecturer_own_students" model="ir.rule">
        <field name="name">Lecturer: transcripts of students in own classes</field>
        <field name="model_id" ref="model_univ_sms_transcript"/>
        <field name="domain_force">[('student_id.enrollment_ids.class_id.lecturer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_lecturer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_officer_all" model="ir.rule">
        <field name="name">Officer/Admin: all transcripts</field>
        <field name="model_id" ref="model_univ_sms_transcript"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_academic_officer'))]"/>
    </record>
    <record id="rule_transcript_advisor_students" model="ir.rule">
        <field name="name">Advisor: read transcripts of advised students</field>
        <field name="model_id" ref="model_univ_sms_transcript"/>
        <field name="domain_force">['|', ('student_id.advisor_id', '=', user.partner_id.id), ('student_id.home_class_id.advisor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_advisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_dean_read_all" model="ir.rule">
        <field name="name">Dean/Student affairs: read all transcripts</field>
        <field name="model_id" ref="model_univ_sms_transcript"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_dean')), (4, ref('univ_sms_base.group_univ_student_affairs_office'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_line_lecturer_own_students" model="ir.rule">
        <field name="name">Lecturer: transcript lines of students in own classes</field>
        <field name="model_id" ref="model_univ_sms_transcript_line"/>
        <field name="domain_force">[('transcript_id.student_id.enrollment_ids.class_id.lecturer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_lecturer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_line_officer_all" model="ir.rule">
        <field name="name">Officer/Admin: all transcript lines</field>
        <field name="model_id" ref="model_univ_sms_transcript_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_academic_officer'))]"/>
    </record>
    <record id="rule_transcript_line_advisor_students" model="ir.rule">
        <field name="name">Advisor: read transcript lines of advised students</field>
        <field name="model_id" ref="model_univ_sms_transcript_line"/>
        <field name="domain_force">['|', ('transcript_id.student_id.advisor_id', '=', user.partner_id.id), ('transcript_id.student_id.home_class_id.advisor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_advisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_transcript_line_dean_read_all" model="ir.rule">
        <field name="name">Dean/Student affairs: read all transcript lines</field>
        <field name="model_id" ref="model_univ_sms_transcript_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('univ_sms_base.group_univ_dean')), (4, ref('univ_sms_base.group_univ_student_affairs_office'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
