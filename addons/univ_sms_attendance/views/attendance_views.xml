<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_univ_sms_attendance_sheet_form" model="ir.ui.view">
        <field name="name">univ.sms.attendance.sheet.form</field>
        <field name="model">univ.sms.attendance.sheet</field>
        <field name="arch" type="xml">
            <form string="Phiếu điểm danh">
                <header>
                    <button name="action_load_students" string="Tải danh sách SV"
                            type="object" class="btn-secondary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_confirm" string="Xác nhận"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Về nháp"
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="class_id"/>
                            <field name="attendance_date"/>
                        </group>
                        <group>
                            <field name="lecturer_id" readonly="True"/>
                            <field name="total_present" readonly="True"/>
                            <field name="total_absent" readonly="True"/>
                            <field name="total_late" readonly="True"/>
                            <field name="total_excused" readonly="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Điểm danh" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="student_id"/>
                                    <field name="state"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_univ_sms_attendance_sheet_tree" model="ir.ui.view">
        <field name="name">univ.sms.attendance.sheet.tree</field>
        <field name="model">univ.sms.attendance.sheet</field>
        <field name="arch" type="xml">
            <tree string="Phiếu điểm danh"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="class_id"/>
                <field name="attendance_date"/>
                <field name="lecturer_id"/>
                <field name="total_present"/>
                <field name="total_absent"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_univ_sms_attendance_sheet_search" model="ir.ui.view">
        <field name="name">univ.sms.attendance.sheet.search</field>
        <field name="model">univ.sms.attendance.sheet</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu điểm danh">
                <field name="class_id"/>
                <field name="attendance_date"/>
                <field name="lecturer_id"/>
                <separator/>
                <filter name="draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_class" string="Lớp" context="{'group_by': 'class_id'}"/>
                    <filter name="group_date" string="Ngày" context="{'group_by': 'attendance_date'}"/>
                    <filter name="group_lecturer" string="Giảng viên" context="{'group_by': 'lecturer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_univ_sms_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Điểm danh</field>
        <field name="res_model">univ.sms.attendance.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_univ_sms_attendance_sheet_search"/>
        <field name="help" type="html">
            <p class="o_view_no_content_smiling_face">
                Tạo phiếu điểm danh đầu tiên
            </p>
            <p>
                Chọn lớp → Tải danh sách sinh viên → Điểm danh → Xác nhận
            </p>
        </field>
    </record>
</odoo>
