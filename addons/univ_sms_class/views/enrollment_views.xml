<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mở rộng form enrollment: thêm class_id + thông tin chuyên cần -->
    <record id="view_enrollment_form_class_extend" model="ir.ui.view">
        <field name="name">univ.sms.enrollment.form.class</field>
        <field name="model">univ.sms.enrollment</field>
        <field name="inherit_id" ref="univ_sms_student.view_univ_sms_enrollment_form"/>
        <field name="arch" type="xml">
            <!-- Thêm cảnh báo chuyên cần vào đầu sheet -->
            <xpath expr="//sheet/group[1]" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not has_attendance_warning">
                    <strong>Cảnh báo chuyên cần:</strong> sinh viên đã vắng
                    <field name="absence_count" nolabel="1" readonly="1"/>
                    /<field name="total_sessions" nolabel="1" readonly="1"/> buổi
                    (<field name="absence_rate" nolabel="1" readonly="1" widget="float" digits="[5,1]"/>%).
                    Vắng quá 20% số buổi học có thể bị cấm thi.
                </div>
            </xpath>
            <!-- Thêm class_id vào nhóm thứ 2 -->
            <xpath expr="//sheet/group/group[2]/field[@name='term_id']" position="after">
                <field name="class_id" readonly="1"/>
            </xpath>
            <!-- Thêm section chuyên cần sau phần thông tin chính -->
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Chuyên cần" invisible="not class_id">
                    <group>
                        <field name="total_sessions" readonly="1"/>
                        <field name="absence_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="absence_rate" readonly="1" widget="float" digits="[5,1]"/>
                        <field name="has_attendance_warning" readonly="1" widget="boolean_toggle"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Mở rộng tree enrollment: thêm class_id + tỷ lệ vắng -->
    <record id="view_enrollment_tree_class_extend" model="ir.ui.view">
        <field name="name">univ.sms.enrollment.tree.class</field>
        <field name="model">univ.sms.enrollment</field>
        <field name="inherit_id" ref="univ_sms_student.view_univ_sms_enrollment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="class_id" optional="show"/>
                <field name="absence_rate" optional="show" string="Vắng (%)"/>
            </xpath>
            <!-- Thêm decoration-warning cho dòng bị cảnh báo -->
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">has_attendance_warning</attribute>
            </xpath>
            <!-- Thêm has_attendance_warning ẩn để dùng cho decoration -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="has_attendance_warning" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
