<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_univ_sms_fee_invoice_form" model="ir.ui.view">
        <field name="name">univ.sms.fee.invoice.form</field>
        <field name="model">univ.sms.fee.invoice</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn học phí">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_paid" type="object" string="Thanh toán" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_create_account_move" type="object" string="Tạo hóa đơn kế toán" invisible="state != 'confirmed'" groups="univ_sms_base.group_univ_admin"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state not in ('draft', 'confirmed')" groups="univ_sms_base.group_univ_admin"/>
                    <button name="action_reset" type="object" string="Về dự thảo" invisible="state != 'cancel'" groups="univ_sms_base.group_univ_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fee_id" options="{'no_create': True}"/>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="term_id" options="{'no_create': True}"/>
                            <field name="invoice_date"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="account_move_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="credit"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_univ_sms_fee_invoice_tree" model="ir.ui.view">
        <field name="name">univ.sms.fee.invoice.tree</field>
        <field name="model">univ.sms.fee.invoice</field>
        <field name="arch" type="xml">
            <tree string="Hóa đơn học phí">
                <field name="name"/>
                <field name="student_id"/>
                <field name="term_id"/>
                <field name="invoice_date"/>
                <field name="amount_total" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_sms_fee_invoice_search" model="ir.ui.view">
        <field name="name">univ.sms.fee.invoice.search</field>
        <field name="model">univ.sms.fee.invoice</field>
        <field name="arch" type="xml">
            <search string="Tìm hóa đơn">
                <field name="name"/>
                <field name="student_id"/>
                <field name="term_id"/>
                <filter name="draft" string="Dự thảo" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="paid" string="Đã thanh toán" domain="[('state', '=', 'paid')]"/>
                <filter name="cancel" string="Đã hủy" domain="[('state', '=', 'cancel')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_student" string="Sinh viên" context="{'group_by': 'student_id'}"/>
                    <filter name="group_by_term" string="Học kỳ" context="{'group_by': 'term_id'}"/>
                    <filter name="group_by_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_sms_fee_invoice" model="ir.actions.act_window">
        <field name="name">Hóa đơn học phí</field>
        <field name="res_model">univ.sms.fee.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
