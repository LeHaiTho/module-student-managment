<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_univ_sms_fee_form" model="ir.ui.view">
        <field name="name">univ.sms.fee.form</field>
        <field name="model">univ.sms.fee</field>
        <field name="arch" type="xml">
            <form string="Học phí">
                <header>
                    <button name="action_create_invoice" type="object" string="Lập hóa đơn" invisible="state != 'draft'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="term_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="fee_per_credit" widget="monetary"/>
                            <field name="total_credits"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="paid_amount" widget="monetary"/>
                            <field name="remaining_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hóa đơn">
                            <field name="invoice_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_univ_sms_fee_tree" model="ir.ui.view">
        <field name="name">univ.sms.fee.tree</field>
        <field name="model">univ.sms.fee</field>
        <field name="arch" type="xml">
            <tree string="Học phí">
                <field name="student_id"/>
                <field name="term_id"/>
                <field name="total_credits"/>
                <field name="fee_per_credit" widget="monetary"/>
                <field name="total_amount" widget="monetary"/>
                <field name="paid_amount" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'invoiced'" decoration-success="state == 'paid'"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_sms_fee_search" model="ir.ui.view">
        <field name="name">univ.sms.fee.search</field>
        <field name="model">univ.sms.fee</field>
        <field name="arch" type="xml">
            <search string="Tìm học phí">
                <field name="student_id"/>
                <field name="term_id"/>
                <filter name="draft" string="Dự kiến" domain="[('state', '=', 'draft')]"/>
                <filter name="invoiced" string="Đã lập hóa đơn" domain="[('state', '=', 'invoiced')]"/>
                <filter name="paid" string="Đã thanh toán" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_student" string="Sinh viên" context="{'group_by': 'student_id'}"/>
                    <filter name="group_by_term" string="Học kỳ" context="{'group_by': 'term_id'}"/>
                    <filter name="group_by_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_sms_fee" model="ir.actions.act_window">
        <field name="name">Học phí</field>
        <field name="res_model">univ.sms.fee</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
