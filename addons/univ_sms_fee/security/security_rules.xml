<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fee_portal_own" model="ir.rule">
        <field name="name">Portal: own fees only</field>
        <field name="model_id" ref="model_univ_sms_fee"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_fee_invoice_portal_own" model="ir.rule">
        <field name="name">Portal: own fee invoices only</field>
        <field name="model_id" ref="model_univ_sms_fee_invoice"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_fee_invoice_line_portal_own" model="ir.rule">
        <field name="name">Portal: own fee invoice lines only</field>
        <field name="model_id" ref="model_univ_sms_fee_invoice_line"/>
        <field name="domain_force">[('invoice_id.student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
