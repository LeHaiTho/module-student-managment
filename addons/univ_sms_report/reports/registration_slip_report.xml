<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Binding trên student để in phiếu ĐKMH của 1 sinh viên -->
    <record id="action_report_registration_slip" model="ir.actions.report">
        <field name="name">Phiếu đăng ký môn học</field>
        <field name="model">univ.sms.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">univ_sms_report.report_registration_slip_template</field>
        <field name="report_file">univ_sms_report.report_registration_slip_template</field>
        <field name="print_report_name">'Phieu_dang_ky_%s' % (object.student_code)</field>
        <field name="binding_model_id" ref="univ_sms_student.model_univ_sms_student"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_registration_slip_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>PHIẾU ĐĂNG KÝ MÔN HỌC</h2>
                        </div>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Họ tên: </strong><span t-field="doc.name"/><br/>
                                <strong>MSSV: </strong><span t-field="doc.student_code"/><br/>
                                <strong>Lớp hành chính: </strong><span t-esc="doc.home_class_id.name or '—'"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Ngành học: </strong><span t-esc="doc.program_id.name"/><br/>
                                <strong>Ngày in: </strong><span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/><br/>
                            </div>
                        </div>

                        <!-- Lấy tất cả đăng ký môn học đã confirmed của sinh viên -->
                        <t t-set="registrations" t-value="doc.env['univ.sms.registration'].search([
                            ('student_id', '=', doc.id),
                            ('state', '=', 'confirmed'),
                        ], order='offering_id')"/>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Mã môn</th>
                                    <th>Tên môn học</th>
                                    <th class="text-center">Số TC</th>
                                    <th>Học kỳ</th>
                                    <th>Giảng viên</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="registrations" t-as="reg">
                                    <td><span t-esc="reg_index + 1"/></td>
                                    <td><span t-esc="reg.offering_id.subject_id.code"/></td>
                                    <td><span t-esc="reg.offering_id.subject_id.name"/></td>
                                    <td class="text-center"><span t-esc="reg.offering_id.subject_id.credit"/></td>
                                    <td><span t-esc="reg.period_id.term_id.name"/></td>
                                    <td><span t-esc="reg.offering_id.lecturer_id.name or '—'"/></td>
                                </tr>
                                <tr t-if="not registrations">
                                    <td colspan="6" class="text-center text-muted">Chưa có môn nào được đăng ký.</td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="registrations">
                            <p class="text-end">
                                <strong>Tổng số tín chỉ: </strong>
                                <span t-esc="sum(r.offering_id.subject_id.credit for r in registrations)"/>
                            </p>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <strong>Sinh viên</strong><br/><br/><br/>Ký tên
                            </div>
                            <div class="col-6 text-center">
                                <strong>Cố vấn học tập</strong><br/><br/><br/>Ký tên
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
