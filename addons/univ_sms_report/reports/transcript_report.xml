<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_student_transcript" model="ir.actions.report">
        <field name="name">Bảng điểm sinh viên</field>
        <field name="model">univ.sms.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">univ_sms_report.report_student_transcript_template</field>
        <field name="report_file">univ_sms_report.report_student_transcript_template</field>
        <field name="print_report_name">'Bảng_điểm_%s' % (object.student_code)</field>
        <field name="binding_model_id" ref="univ_sms_student.model_univ_sms_student"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_student_transcript_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>BẢNG ĐIỂM SINH VIÊN</h2>
                        </div>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Họ tên: </strong><span t-field="doc.name"/><br/>
                                <strong>MSSV: </strong><span t-field="doc.student_code"/><br/>
                                <strong>Lớp: </strong><span t-esc="doc.home_class_id.name or '—'"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Ngành học: </strong><span t-field="doc.program_id.name"/><br/>
                                <strong>Hệ đào tạo: </strong><span t-esc="dict(doc._fields['training_system'].selection).get(doc.training_system, '—')"/><br/>
                                <strong>Ngày in: </strong><span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/><br/>
                            </div>
                        </div>

                        <!-- Điểm tổng kết từng môn lấy từ bảng điểm (transcript), nhóm theo học kỳ -->
                        <t t-set="transcripts" t-value="doc.env['univ.sms.transcript'].search(
                            [('student_id', '=', doc.id)]).filtered(lambda t: t.line_ids).sorted(
                            key=lambda t: (t.term_id.date_start or datetime.date.min, t.id))"/>
                        <t t-if="not transcripts">
                            <p class="text-center text-muted mt-4">Chưa có dữ liệu điểm tổng kết.</p>
                        </t>
                        <t t-set="acc_points" t-value="0.0"/>
                        <t t-set="acc_credits" t-value="0.0"/>
                        <t t-foreach="transcripts" t-as="tr">
                            <t t-set="acc_points" t-value="acc_points + sum(l.grade_point * l.credit for l in tr.line_ids)"/>
                            <t t-set="acc_credits" t-value="acc_credits + sum(tr.line_ids.mapped('credit'))"/>
                            <h5 class="mt-4 mb-2">
                                <t t-esc="tr.term_id.name"/>
                                <t t-if="tr.term_id.academic_year_id"> – Năm học <t t-esc="tr.term_id.academic_year_id.name"/></t>
                            </h5>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:6%">STT</th>
                                        <th style="width:14%">Mã môn</th>
                                        <th>Môn học</th>
                                        <th class="text-center" style="width:8%">TC</th>
                                        <th class="text-center" style="width:12%">Điểm</th>
                                        <th class="text-center" style="width:10%">Điểm chữ</th>
                                        <th class="text-center" style="width:12%">Kết quả</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="tr.line_ids.sorted(key=lambda l: l.subject_id.code or '')" t-as="line">
                                        <td><span t-esc="line_index + 1"/></td>
                                        <td><span t-esc="line.subject_id.code"/></td>
                                        <td><span t-esc="line.subject_id.name"/></td>
                                        <td class="text-center"><span t-esc="'%g' % line.credit"/></td>
                                        <td class="text-center"><span t-esc="'%.2f' % line.final_score"/></td>
                                        <td class="text-center"><span t-esc="line.grade_letter"/></td>
                                        <td class="text-center">
                                            <span t-if="line.final_score &gt;= 5.0" style="color:green;font-weight:bold;">Đạt</span>
                                            <span t-else="" style="color:red;">Không đạt</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="mb-3">
                                <strong>GPA học kỳ:</strong> <span t-esc="'%.2f' % tr.term_gpa"/> ·
                                <strong>GPA tích lũy:</strong> <span t-esc="'%.2f' % (acc_points / acc_credits if acc_credits else 0.0)"/> ·
                                <strong>Xếp loại:</strong> <span t-esc="dict(tr._fields['classification'].selection).get(tr.classification, '—')"/>
                            </p>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <strong>Phòng Đào tạo</strong><br/><br/><br/>Ký tên
                            </div>
                            <div class="col-6 text-center">
                                <strong>Ngày ......./......./........</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
