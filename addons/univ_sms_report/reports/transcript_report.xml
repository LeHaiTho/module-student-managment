<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_student_transcript" model="ir.actions.report">
        <field name="name">Bảng điểm sinh viên</field>
        <field name="model">univ.sms.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">univ_sms_report.report_student_transcript_template</field>
        <field name="report_file">univ_sms_report.report_student_transcript_template</field>
        <field name="print_report_name">'Bảng_điểm_%s' % (object.student_code)</field>
        <field name="binding_model_id" ref="univ_sms_student.model_univ_sms_student"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_student_transcript_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>BẢNG ĐIỂM SINH VIÊN</h2>
                        </div>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Họ tên: </strong><span t-field="doc.name"/><br/>
                                <strong>MSSV: </strong><span t-field="doc.student_code"/><br/>
                                <strong>Lớp: </strong><span t-esc="doc.home_class_id.name or '—'"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Ngành học: </strong><span t-field="doc.program_id.name"/><br/>
                                <strong>Hệ đào tạo: </strong><span t-esc="dict(doc._fields['training_system'].selection).get(doc.training_system, '—')"/><br/>
                                <strong>Ngày in: </strong><span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/><br/>
                            </div>
                        </div>

                        <!-- Lấy điểm số từ exam.result (có related fields subject_id, term_id, is_passed) -->
                        <t t-set="results" t-value="doc.env['univ.sms.exam.result'].search(
                            [('student_id', '=', doc.id)],
                            order='term_id, subject_id'
                        )"/>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Môn học</th>
                                    <th>Học kỳ</th>
                                    <th class="text-center">Điểm</th>
                                    <th class="text-center">Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="results" t-as="res">
                                    <td><span t-esc="res_index + 1"/></td>
                                    <td><span t-field="res.subject_id.name"/></td>
                                    <td><span t-field="res.term_id.name"/></td>
                                    <td class="text-center"><span t-field="res.score"/></td>
                                    <td class="text-center">
                                        <span t-if="res.is_passed" style="color:green;font-weight:bold;">Đạt</span>
                                        <span t-else="" style="color:red;">Không đạt</span>
                                    </td>
                                </tr>
                                <tr t-if="not results">
                                    <td colspan="5" class="text-center text-muted">Chưa có dữ liệu điểm số.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <strong>Phòng Đào tạo</strong><br/><br/><br/>Ký tên
                            </div>
                            <div class="col-6 text-center">
                                <strong>Ngày ......./......./........</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
