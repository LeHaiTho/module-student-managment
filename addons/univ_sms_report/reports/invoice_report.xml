<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_student_fee_invoice" model="ir.actions.report">
        <field name="name">Biên lai học phí</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">univ_sms_report.report_student_fee_invoice_template</field>
        <field name="report_file">univ_sms_report.report_student_fee_invoice_template</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_student_fee_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>BIÊN LAI THU HỌC PHÍ</h2>
                            <h4><span t-field="doc.name"/></h4>
                        </div>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Sinh viên: </strong> <span t-field="doc.partner_id.name"/><br/>
                                <strong>Email: </strong> <span t-field="doc.partner_id.email"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Ngày lập: </strong> <span t-field="doc.invoice_date"/><br/>
                                <strong>Trạng thái: </strong> <span t-field="doc.payment_state"/><br/>
                            </div>
                        </div>
                        
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Nội dung</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.invoice_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.price_unit"/></td>
                                    <td><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Tổng cộng:</strong></td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_total"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
