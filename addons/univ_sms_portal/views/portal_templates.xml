<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_academic" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Học tập</t>
                <t t-set="url" t-value="'/my/academic'"/>
                <t t-set="count" t-value="enrollment_count"/>
            </t>
        </xpath>
    </template>

    <template id="portal_academic_home" name="Academic Home">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <t t-if="not student">
                    <div class="alert alert-warning">
                        Tài khoản này chưa được liên kết với hồ sơ sinh viên nào.
                        Bạn có thể đăng ký hồ sơ trực tuyến hoặc liên hệ phòng đào tạo để được hỗ trợ.
                        <div class="mt-2">
                            <a href="/student/register" class="btn btn-sm btn-primary">Đăng ký hồ sơ sinh viên</a>
                        </div>
                    </div>
                </t>
                <t t-else="">
                <div t-if="student.state == 'draft'" class="alert alert-info">
                    Hồ sơ sinh viên của bạn đang ở trạng thái chờ xác nhận nhập học.
                    Một số chức năng học vụ như đăng ký môn sẽ được mở sau khi hồ sơ được duyệt.
                </div>
                <h3>Xin chào, <t t-esc="student.name"/></h3>
                <p><strong>MSSV:</strong> <t t-esc="student.student_code"/></p>
                <p><strong>Ngành:</strong> <t t-esc="student.program_id.name"/></p>
                <p t-if="student.home_class_id">
                    <strong>Lớp hành chính:</strong> <t t-esc="student.home_class_id.name"/>
                </p>
                <p t-if="student.school_email">
                    <strong>Email trường:</strong> <t t-esc="student.school_email"/>
                </p>
                <div class="row mt-4 g-2">
                    <div class="col-auto">
                        <a href="/my/academic/registration" class="btn btn-primary">
                            Đăng ký môn học
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/timetable" class="btn btn-primary">
                            Thời khóa biểu
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/transcript" class="btn btn-secondary">Bảng điểm</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/attendance" class="btn btn-secondary">Điểm danh</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/fees" class="btn btn-secondary">Học phí</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/certificates" class="btn btn-secondary">Giấy chứng nhận</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/student-affairs" class="btn btn-secondary">Công tác SV</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/conduct" class="btn btn-secondary">Rèn luyện</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/surveys" class="btn btn-secondary">Khảo sát</a>
                    </div>
                    <div class="col-auto">
                        <a href="/my/academic/feedback" class="btn btn-secondary">Góp ý</a>
                    </div>
                </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_student_register" name="Student Register">
        <t t-call="portal.portal_layout">
            <div class="o_portal_my_doc_table">
                <h3>Đăng ký hồ sơ sinh viên</h3>
                <p class="text-muted">
                    Điền thông tin để tạo tài khoản portal và gửi hồ sơ sinh viên chờ Phòng Đào tạo xác nhận.
                </p>

                <t t-if="success_data">
                    <div class="alert alert-success mt-3">
                        <strong>Đăng ký thành công.</strong>
                        Hồ sơ của <t t-esc="success_data.get('student_name')"/> đã được ghi nhận với MSSV
                        <strong><t t-esc="success_data.get('student_code')"/></strong>.
                        <div class="mt-2">
                            Tài khoản đăng nhập: <strong><t t-esc="success_data.get('login')"/></strong>
                        </div>
                        <div class="mt-3">
                            <a href="/web/login?redirect=/my/academic" class="btn btn-primary">Đăng nhập portal</a>
                            <a href="/university" class="btn btn-outline-secondary ms-2">Về trang chủ</a>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="errors">
                        <div class="alert alert-danger mt-3">
                            <ul class="mb-0 ps-3">
                                <li t-foreach="errors" t-as="error"><t t-esc="error"/></li>
                            </ul>
                        </div>
                    </t>

                    <form action="/student/register/submit" method="post" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ và tên</label>
                                <input type="text" name="name" class="form-control" required="required"
                                       t-att-value="form_values.get('name', '')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Ngày sinh</label>
                                <input type="date" name="date_of_birth" class="form-control" required="required"
                                       t-att-value="form_values.get('date_of_birth', '')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Giới tính</label>
                                <select name="gender" class="form-select">
                                    <option t-foreach="genders" t-as="gender" t-att-value="gender[0]"
                                            t-att-selected="gender[0] == form_values.get('gender') and 'selected' or None">
                                        <t t-esc="gender[1]"/>
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6" t-if="is_public_user">
                                <label class="form-label">Tên đăng nhập</label>
                                <input type="text" name="login" class="form-control" required="required"
                                       placeholder="Ví dụ: nguyenvanan hoặc email"
                                       t-att-value="form_values.get('login', '')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email liên hệ</label>
                                <input type="email" name="personal_email" class="form-control" required="required"
                                       t-att-value="form_values.get('personal_email', '')"/>
                            </div>
                            <div class="col-md-3" t-if="is_public_user">
                                <label class="form-label">Mật khẩu</label>
                                <input type="password" name="password" class="form-control" required="required"/>
                            </div>
                            <div class="col-md-3" t-if="is_public_user">
                                <label class="form-label">Xác nhận mật khẩu</label>
                                <input type="password" name="confirm_password" class="form-control" required="required"/>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="text" name="phone" class="form-control"
                                       t-att-value="form_values.get('phone', '')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Di động</label>
                                <input type="text" name="mobile" class="form-control"
                                       t-att-value="form_values.get('mobile', '')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">CCCD/CMND</label>
                                <input type="text" name="id_number" class="form-control"
                                       t-att-value="form_values.get('id_number', '')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Hệ đào tạo</label>
                                <select name="training_system" class="form-select">
                                    <option t-foreach="training_systems" t-as="training_system"
                                            t-att-value="training_system[0]"
                                            t-att-selected="training_system[0] == form_values.get('training_system') and 'selected' or None">
                                        <t t-esc="training_system[1]"/>
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ngành học</label>
                                <select name="program_id" class="form-select" required="required">
                                    <option value="">Chọn ngành học</option>
                                    <option t-foreach="programs" t-as="program" t-att-value="program.id"
                                            t-att-selected="str(program.id) == form_values.get('program_id') and 'selected' or None">
                                        <t t-esc="program.name"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Niên khóa nhập học</label>
                                <select name="academic_year_id" class="form-select" required="required">
                                    <option value="">Chọn niên khóa</option>
                                    <option t-foreach="academic_years" t-as="year" t-att-value="year.id"
                                            t-att-selected="str(year.id) == form_values.get('academic_year_id') and 'selected' or None">
                                        <t t-esc="year.name"/>
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Địa chỉ thường trú</label>
                                <input type="text" name="home_address" class="form-control"
                                       t-att-value="form_values.get('home_address', '')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Địa chỉ tạm trú hiện tại</label>
                                <input type="text" name="current_address" class="form-control"
                                       t-att-value="form_values.get('current_address', '')"/>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Gửi hồ sơ đăng ký</button>
                            <a href="/university" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    </form>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_transcript" name="Transcript">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3>Bảng điểm: <t t-esc="student.name"/></h3>
                <table class="table table-sm table-striped mt-3">
                    <thead>
                        <tr>
                            <th>Môn học</th>
                            <th>Học kỳ</th>
                            <th>Điểm</th>
                            <th>Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- results là univ.sms.exam.result có related fields: subject_id, term_id, is_passed -->
                        <tr t-foreach="results" t-as="res">
                            <td><t t-esc="res.subject_id.name"/></td>
                            <td><t t-esc="res.term_id.name"/></td>
                            <td><t t-esc="res.score"/></td>
                            <td>
                                <span t-if="res.is_passed" class="badge bg-success">Đạt</span>
                                <span t-else="" class="badge bg-danger">Không đạt</span>
                            </td>
                        </tr>
                        <tr t-if="not results">
                            <td colspan="4" class="text-center text-muted">Chưa có dữ liệu bảng điểm.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_attendance" name="Attendance">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3>Điểm danh: <t t-esc="student.name"/></h3>
                <table class="table table-sm table-striped mt-3">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Lớp học phần</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- attendance_lines là univ.sms.attendance.line -->
                        <!-- Ngày lấy từ sheet_id.attendance_date, lớp từ sheet_id.class_id -->
                        <tr t-foreach="attendance_lines" t-as="att">
                            <td><t t-esc="att.sheet_id.attendance_date"/></td>
                            <td><t t-esc="att.sheet_id.class_id.name"/></td>
                            <td>
                                <span t-attf-class="badge #{
                                    'bg-success' if att.state == 'present' else
                                    'bg-warning' if att.state == 'late' else
                                    'bg-info' if att.state == 'excused' else 'bg-danger'
                                }">
                                    <t t-if="att.state == 'present'">Có mặt</t>
                                    <t t-elif="att.state == 'absent'">Vắng</t>
                                    <t t-elif="att.state == 'late'">Đi trễ</t>
                                    <t t-elif="att.state == 'excused'">Có phép</t>
                                </span>
                            </td>
                        </tr>
                        <tr t-if="not attendance_lines">
                            <td colspan="3" class="text-center text-muted">Chưa có dữ liệu điểm danh.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_registration" name="Đăng ký môn học">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3>Đăng ký môn học</h3>

                <t t-if="not period">
                    <div class="alert alert-info mt-3">
                        Hiện không có đợt đăng ký môn học nào đang mở.
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-success mt-3">
                        <strong>Đợt ĐKMH đang mở:</strong> <t t-esc="period.name"/>
                        — Học kỳ: <t t-esc="period.term_id.name"/>
                        <span t-if="period.max_credit">
                            | Tối đa <t t-esc="period.max_credit"/> TC
                        </span>
                    </div>

                    <!-- Danh sách môn đã đăng ký -->
                    <h5 class="mt-4">Môn đã đăng ký</h5>
                    <t t-if="not my_registrations">
                        <p class="text-muted">Chưa đăng ký môn nào.</p>
                    </t>
                    <table t-else="" class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Môn học</th>
                                <th>Số TC</th>
                                <th>Giảng viên</th>
                                <th>Sĩ số</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="my_registrations" t-as="reg">
                                <td><t t-esc="reg.offering_id.subject_id.name"/></td>
                                <td><t t-esc="reg.offering_id.subject_id.credit"/> TC</td>
                                <td><t t-esc="reg.offering_id.lecturer_id.name or '—'"/></td>
                                <td>
                                    <t t-esc="reg.offering_id.registered_count"/>/<t t-esc="reg.offering_id.max_seats"/>
                                </td>
                                <td>
                                    <span t-attf-class="badge #{
                                        'bg-success' if reg.state == 'confirmed' else
                                        'bg-primary' if reg.state == 'registered' else
                                        'bg-warning' if reg.state == 'draft' else 'bg-secondary'
                                    }">
                                        <t t-if="reg.state == 'confirmed'">Đã xác nhận</t>
                                        <t t-elif="reg.state == 'registered'">Đã đăng ký</t>
                                        <t t-elif="reg.state == 'draft'">Nháp</t>
                                        <t t-else="">Đã hủy</t>
                                    </span>
                                </td>
                                <td>
                                    <form t-if="reg.state in ('draft', 'registered')"
                                          t-attf-action="/my/academic/registration/cancel/#{reg.id}"
                                          method="post"
                                          onsubmit="return confirm('Xác nhận hủy đăng ký?')">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                    </form>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Danh sách môn mở -->
                    <h5 class="mt-4">Các lớp môn học đang mở</h5>
                    <t t-if="not offerings">
                        <p class="text-muted">Không có lớp môn học nào được mở trong học kỳ này.</p>
                    </t>
                    <table t-else="" class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Môn học</th>
                                <th>Số TC</th>
                                <th>Giảng viên</th>
                                <th>Còn chỗ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="offerings" t-as="off">
                                <t t-set="already_registered" t-value="off.id in registered_offering_ids"/>
                                <t t-set="is_full" t-value="off.registered_count >= off.max_seats"/>
                                <tr t-attf-class="#{
                                    'table-success' if already_registered else
                                    'text-muted' if is_full else ''
                                }">
                                    <td>
                                        <strong><t t-esc="off.subject_id.name"/></strong>
                                        <small t-if="off.subject_id.code" class="text-muted ms-1">
                                            (<t t-esc="off.subject_id.code"/>)
                                        </small>
                                    </td>
                                    <td><t t-esc="off.subject_id.credit"/> TC</td>
                                    <td><t t-esc="off.lecturer_id.name or '—'"/></td>
                                    <td>
                                        <span t-attf-class="badge #{
                                            'bg-danger' if is_full else 'bg-success'
                                        }">
                                            <t t-esc="off.max_seats - off.registered_count"/> chỗ
                                        </span>
                                    </td>
                                    <td>
                                        <span t-if="already_registered" class="badge bg-success">Đã đăng ký</span>
                                        <button t-elif="not is_full"
                                                class="btn btn-sm btn-primary portal-reg-btn"
                                                t-att-data-offering-id="off.id">
                                            Đăng ký
                                        </button>
                                        <span t-else="" class="text-danger">Đã đủ chỗ</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <div class="mt-3">
                    <a href="/my/academic" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
                </div>
            </div>

            <script>
                document.querySelectorAll('.portal-reg-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var offeringId = this.dataset.offeringId;
                        var self = this;
                        self.disabled = true;
                        self.textContent = 'Đang đăng ký...';
                        fetch('/my/academic/registration/add', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({
                                jsonrpc: '2.0', method: 'call', id: 1,
                                params: {offering_id: parseInt(offeringId)}
                            })
                        })
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            if (data.result &amp;&amp; data.result.success) {
                                location.reload();
                            } else {
                                var msg = (data.result &amp;&amp; data.result.error) || 'Đăng ký thất bại';
                                alert(msg);
                                self.disabled = false;
                                self.textContent = 'Đăng ký';
                            }
                        });
                    });
                });
            </script>
        </t>
    </template>

    <template id="portal_timetable" name="Thời khóa biểu">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3>Thời khóa biểu</h3>
                <t t-if="not timetable_slots">
                    <div class="alert alert-info mt-3">
                        Chưa có thời khóa biểu. Vui lòng đăng ký môn học trước.
                    </div>
                </t>
                <t t-else="">
                    <table class="table table-sm table-bordered mt-3">
                        <thead class="table-light">
                            <tr>
                                <th>Thứ</th>
                                <th>Giờ học</th>
                                <th>Môn học</th>
                                <th>Mã lớp</th>
                                <th>Giảng viên</th>
                                <th>Phòng</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="timetable_slots" t-as="slot">
                                <t t-set="day_map" t-value="{
                                    '0': 'Thứ Hai', '1': 'Thứ Ba', '2': 'Thứ Tư',
                                    '3': 'Thứ Năm', '4': 'Thứ Sáu', '5': 'Thứ Bảy', '6': 'Chủ nhật'
                                }"/>
                                <tr>
                                    <td><strong><t t-esc="day_map.get(slot.day_of_week, slot.day_of_week)"/></strong></td>
                                    <td>
                                        <t t-esc="'%02d:%02d' % (int(slot.start_time), int((slot.start_time % 1) * 60))"/>
                                        –
                                        <t t-esc="'%02d:%02d' % (int(slot.end_time), int((slot.end_time % 1) * 60))"/>
                                    </td>
                                    <td><t t-esc="slot.class_id.subject_id.name"/></td>
                                    <td><t t-esc="slot.class_id.code"/></td>
                                    <td><t t-esc="slot.class_id.lecturer_id.name or '—'"/></td>
                                    <td>
                                        <t t-esc="slot.room or '—'"/>
                                        <small t-if="slot.building" class="text-muted">
                                            (<t t-esc="slot.building"/>)
                                        </small>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <div class="mt-3">
                    <a href="/my/academic" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fees" name="Fees">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3>Học phí: <t t-esc="student.name"/></h3>
                <table class="table table-sm table-striped mt-3">
                    <thead>
                        <tr>
                            <th>Học kỳ</th>
                            <th>Tổng tín chỉ</th>
                            <th>Tổng tiền</th>
                            <th>Đã đóng</th>
                            <th>Còn nợ</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- fees là univ.sms.fee records -->
                        <tr t-foreach="fees" t-as="fee">
                            <td><t t-esc="fee.term_id.name"/></td>
                            <td><t t-esc="fee.total_credits"/> TC</td>
                            <td><t t-esc="'{:,.0f}'.format(fee.total_amount)"/> đ</td>
                            <td><t t-esc="'{:,.0f}'.format(fee.paid_amount)"/> đ</td>
                            <td>
                                <span t-attf-class="badge #{
                                    'bg-danger' if fee.remaining_amount > 0 else 'bg-success'
                                }">
                                    <t t-esc="'{:,.0f}'.format(fee.remaining_amount)"/> đ
                                </span>
                            </td>
                            <td>
                                <span t-attf-class="badge #{
                                    'bg-success' if fee.state == 'paid' else
                                    'bg-warning' if fee.state == 'invoiced' else 'bg-secondary'
                                }">
                                    <t t-if="fee.state == 'paid'">Đã thanh toán</t>
                                    <t t-elif="fee.state == 'invoiced'">Đã xuất hóa đơn</t>
                                    <t t-else="">Chưa xuất hóa đơn</t>
                                </span>
                            </td>
                        </tr>
                        <tr t-if="not fees">
                            <td colspan="6" class="text-center text-muted">Chưa có dữ liệu học phí.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
