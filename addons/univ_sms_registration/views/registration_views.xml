<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_registration_tree" model="ir.ui.view">
        <field name="name">univ.sms.registration.tree</field>
        <field name="model">univ.sms.registration</field>
        <field name="arch" type="xml">
            <tree string="Đăng ký môn học"
                  decoration-success="state == 'confirmed'"
                  decoration-info="state == 'registered'"
                  decoration-muted="state == 'cancelled'">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="offering_id"/>
                <field name="period_id"/>
                <field name="term_id"/>
                <field name="subject_credit" sum="Tổng tín chỉ"/>
                <field name="available_seats"/>
                <field name="registration_date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'registered'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_registration_form" model="ir.ui.view">
        <field name="name">univ.sms.registration.form</field>
        <field name="model">univ.sms.registration</field>
        <field name="arch" type="xml">
            <form string="Đăng ký môn học">
                <header>
                    <button name="action_register" type="object" string="Đăng ký"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_confirm" type="object" string="Xác nhận"
                            invisible="state not in ('draft', 'registered')" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Hủy"
                            invisible="state == 'cancelled'" class="btn-danger"/>
                    <button name="action_draft" type="object" string="Đặt lại nháp"
                            invisible="state != 'cancelled'" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,registered,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="student_id"/>
                        <h1><field name="student_id" options="{'no_create': True}"/></h1>
                    </div>

                    <group>
                        <group string="Thông tin đăng ký">
                            <field name="period_id" options="{'no_create': True}"/>
                            <field name="period_term_id" invisible="1"/>
                            <field name="offering_id"
                                   domain="[('term_id', '=', period_term_id), ('active', '=', True)]"
                                   options="{'no_create': True}"/>
                            <field name="registration_date" readonly="1"/>
                        </group>
                        <group string="Thông tin môn học">
                            <field name="subject_id" readonly="1"/>
                            <field name="term_id" readonly="1"/>
                            <field name="subject_credit" readonly="1"/>
                            <field name="available_seats" readonly="1"/>
                            <field name="registered_credit" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_registration_search" model="ir.ui.view">
        <field name="name">univ.sms.registration.search</field>
        <field name="model">univ.sms.registration</field>
        <field name="arch" type="xml">
            <search string="Tìm đăng ký môn học">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="offering_id"/>
                <field name="period_id"/>
                <field name="term_id"/>
                <separator/>
                <filter name="draft" string="Nháp" domain="[('state','=','draft')]"/>
                <filter name="registered" string="Đã đăng ký" domain="[('state','=','registered')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state','=','confirmed')]"/>
                <filter name="cancelled" string="Đã hủy" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="active_registration" string="Còn hiệu lực"
                        domain="[('state','in',('draft','registered','confirmed'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_student" string="Sinh viên" context="{'group_by':'student_id'}"/>
                    <filter name="group_period" string="Đợt ĐK" context="{'group_by':'period_id'}"/>
                    <filter name="group_term" string="Học kỳ" context="{'group_by':'term_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_registration" model="ir.actions.act_window">
        <field name="name">Đăng ký môn học</field>
        <field name="res_model">univ.sms.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_registration_search"/>
        <field name="context">{'search_default_active_registration': 1}</field>
    </record>
</odoo>
