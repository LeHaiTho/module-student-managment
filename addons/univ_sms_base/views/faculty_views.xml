<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_univ_sms_faculty_kanban" model="ir.ui.view">
        <field name="name">univ.sms.faculty.kanban</field>
        <field name="model">univ.sms.faculty</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="position:relative;">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span class="fa fa-university me-1" style="color:#1a73e8;"/>
                                        <field name="name"/>
                                    </strong>
                                    <span class="faculty-badge" style="background:#e3f2fd;color:#1565c0;">
                                        <field name="code"/>
                                    </span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 text-muted small">
                                    <i class="fa fa-users"/> <field name="department_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <field name="active" widget="boolean_toggle"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_univ_sms_faculty_form" model="ir.ui.view">
        <field name="name">univ.sms.faculty.form</field>
        <field name="model">univ.sms.faculty</field>
        <field name="arch" type="xml">
            <form string="Khoa">
                <sheet>
                    <div class="oe_title d-flex align-items-center">
                        <span class="fa fa-university fa-3x me-3" style="color:#1a73e8;"/>
                        <div>
                            <label for="name"/>
                            <h1><field name="name" placeholder="Tên khoa"/></h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="code" class="me-2"/>
                            <field name="dean_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📂 Bộ môn" name="departments">
                            <field name="department_ids">
                                <kanban>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click">
                                                <i class="fa fa-folder-open-o" style="color:#34a853;"/>
                                                <strong><field name="name"/></strong>
                                                <span class="badge badge-pill bg-light text-dark ms-2"><field name="code"/></span>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_univ_sms_faculty_tree" model="ir.ui.view">
        <field name="name">univ.sms.faculty.tree</field>
        <field name="model">univ.sms.faculty</field>
        <field name="arch" type="xml">
            <tree string="Khoa" decoration-success="active==True" decoration-muted="active==False">
                <field name="code"/>
                <field name="name"/>
                <field name="dean_id"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_univ_sms_faculty_search" model="ir.ui.view">
        <field name="name">univ.sms.faculty.search</field>
        <field name="model">univ.sms.faculty</field>
        <field name="arch" type="xml">
            <search string="Tìm khoa">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="📦 Đã lưu trữ" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="active" string="✅ Đang hoạt động" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_univ_sms_faculty" model="ir.actions.act_window">
        <field name="name">Khoa</field>
        <field name="res_model">univ.sms.faculty</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_univ_sms_faculty_search"/>
        <field name="help" type="html">
            <p class="o_view_no_content_smiling_face">
                🏫 Tạo khoa đầu tiên để bắt đầu quản lý đào tạo
            </p>
        </field>
    </record>
</odoo>