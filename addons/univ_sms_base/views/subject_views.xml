<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_univ_sms_subject_form" model="ir.ui.view">
        <field name="name">univ.sms.subject.form</field>
        <field name="model">univ.sms.subject</field>
        <field name="arch" type="xml">
            <form string="Môn học">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tên môn học"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="credit"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thuộc ngành" name="programs">
                            <field name="program_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_univ_sms_subject_tree" model="ir.ui.view">
        <field name="name">univ.sms.subject.tree</field>
        <field name="model">univ.sms.subject</field>
        <field name="arch" type="xml">
            <tree string="Môn học">
                <field name="code"/>
                <field name="name"/>
                <field name="credit"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_univ_sms_subject_search" model="ir.ui.view">
        <field name="name">univ.sms.subject.search</field>
        <field name="model">univ.sms.subject</field>
        <field name="arch" type="xml">
            <search string="Tìm môn học">
                <field name="name"/>
                <field name="code"/>
                <filter name="active_only" string="Còn áp dụng" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Đã ngưng" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_univ_sms_subject" model="ir.actions.act_window">
        <field name="name">Môn học</field>
        <field name="res_model">univ.sms.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_univ_sms_subject_search"/>
        <field name="help" type="html">
            <p class="o_view_no_content_smiling_face">
                Tạo môn học đầu tiên
            </p>
        </field>
    </record>
</odoo>
