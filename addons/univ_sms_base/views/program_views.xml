<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_univ_sms_program_form" model="ir.ui.view">
        <field name="name">univ.sms.program.form</field>
        <field name="model">univ.sms.program</field>
        <field name="arch" type="xml">
            <form string="Ngành đào tạo">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tên ngành"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="total_credits"/>
                            <field name="duration_years"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_univ_sms_program_tree" model="ir.ui.view">
        <field name="name">univ.sms.program.tree</field>
        <field name="model">univ.sms.program</field>
        <field name="arch" type="xml">
            <tree string="Ngành đào tạo">
                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="total_credits"/>
                <field name="duration_years"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_univ_sms_program_search" model="ir.ui.view">
        <field name="name">univ.sms.program.search</field>
        <field name="model">univ.sms.program</field>
        <field name="arch" type="xml">
            <search string="Tìm ngành đào tạo">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_department" string="Bộ môn" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_univ_sms_program" model="ir.actions.act_window">
        <field name="name">Ngành đào tạo</field>
        <field name="res_model">univ.sms.program</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_univ_sms_program_search"/>
        <field name="help" type="html">
            <p class="o_view_no_content_smiling_face">
                Tạo ngành đào tạo đầu tiên
            </p>
        </field>
    </record>
</odoo>
