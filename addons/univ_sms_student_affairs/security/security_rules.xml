<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_health_insurance_portal_own" model="ir.rule">
        <field name="name">Portal: own health insurance only</field>
        <field name="model_id" ref="model_univ_sms_health_insurance"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_residence_info_portal_own" model="ir.rule">
        <field name="name">Portal: own residence info only</field>
        <field name="model_id" ref="model_univ_sms_residence_info"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_military_service_portal_own" model="ir.rule">
        <field name="name">Portal: own military service only</field>
        <field name="model_id" ref="model_univ_sms_military_service"/>
        <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
