<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_residence_info_tree" model="ir.ui.view">
        <field name="name">univ.sms.residence.info.tree</field>
        <field name="model">univ.sms.residence.info</field>
        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="residence_type"/>
                <field name="address"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_residence_info_form" model="ir.ui.view">
        <field name="name">univ.sms.residence.info.form</field>
        <field name="model">univ.sms.residence.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_draft" type="object" string="Đặt lại nháp"
                            invisible="state != 'confirmed'" class="btn-default"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="residence_type"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="landlord_name"/>
                            <field name="landlord_phone"/>
                        </group>
                    </group>
                    <group>
                        <field name="address" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_residence_info" model="ir.actions.act_window">
        <field name="name">Thông tin ngoại trú</field>
        <field name="res_model">univ.sms.residence.info</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>