<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence cho Mã số sinh viên (MSSV) -->
        <!-- Format MSSV: [2 số năm][mã ngành][seq 4 chữ số] → VD: 24CNTT0001 -->
        <!-- Prefix và year được ghép trong Python create(), sequence chỉ sinh số thứ tự -->
        <record id="seq_student_code" model="ir.sequence">
            <field name="name">Mã số sinh viên</field>
            <field name="code">univ.sms.student</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
